,{"target":"main-server-requests#Interactive turns never replay","fromSection":"lat.md/chat-commands#Slash command execution#Structured command approvals","file":"lat.md/chat-commands","line":187},{"target":"src/renderer/src/screens/Chat/hooks/useChatActions.ts#parseBackgroundCommand","fromSection":"lat.md/chat-commands#Slash command execution#Side questions (/btw)","file":"lat.md/chat-commands","line":213},{"target":"src/renderer/src/screens/Chat/Chat.tsx","fromSection":"lat.md/chat-commands#Slash command execution#Side questions (/btw)","file":"lat.md/chat-commands","line":213},{"target":"src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport","fromSection":"lat.md/chat-commands#Slash command execution#Side questions (/btw)","file":"lat.md/chat-commands","line":213},{"target":"src/renderer/src/screens/Chat/slash/handleSlashCommand.ts#handleSlashCommand","fromSection":"lat.md/chat-commands#Slash command execution#Central command router","file":"lat.md/chat-commands","line":217},{"target":"src/renderer/src/screens/Chat/slash/commandCatalog.ts#createSlashCatalog","fromSection":"lat.md/chat-commands#Slash command execution#Central command router","file":"lat.md/chat-commands","line":221},{"target":"agent-capabilities#Bounded command inventory","fromSection":"lat.md/chat-commands#Slash command execution#Central command router","file":"lat.md/chat-commands","line":223},{"target":"src/renderer/src/screens/Chat/slash/commandCatalog.ts#reconcileSlashCatalog","fromSection":"lat.md/chat-commands#Slash command execution#Central command router","file":"lat.md/chat-commands","line":225},{"target":"src/renderer/src/screens/Chat/slash/commandCatalog.ts#agentCommandsFromCatalog","fromSection":"lat.md/chat-commands#Slash command execution#Central command router","file":"lat.md/chat-commands","line":227},{"target":"src/renderer/src/screens/Chat/slash/desktopCommands.ts#DESKTOP_SLASH_COMMANDS","fromSection":"lat.md/chat-commands#Slash command execution#Central command router#Desktop commands","file":"lat.md/chat-commands","line":231},{"target":"src/renderer/src/screens/Chat/hooks/useChatActions.ts#useChatActions","fromSection":"lat.md/chat-commands#Slash command execution#Central command router#Desktop commands","file":"lat.md/chat-commands","line":233},{"target":"src/renderer/src/screens/Layout/Layout.tsx","fromSection":"lat.md/chat-commands#Slash command execution#Central command router#Desktop commands","file":"lat.md/chat-commands","line":235},{"target":"sidebar-navigation#Settings modal","fromSection":"lat.md/chat-commands#Slash command execution#Central command router#Desktop commands","file":"lat.md/chat-commands","line":235},{"target":"src/renderer/src/components/settings/SettingsModal.tsx#resolveSection","fromSection":"lat.md/chat-commands#Slash command execution#Central command router#Desktop commands","file":"lat.md/chat-commands","line":235},{"target":"src/renderer/src/screens/Chat/slash/executeAgentCommand.ts#executeAgentCommand","fromSection":"lat.md/chat-commands#Slash command execution#Central command router#Agent commands","file":"lat.md/chat-commands","line":241},{"target":"src/renderer/src/screens/Chat/slash/prepareModelSubmission.ts#prepareModelSubmission","fromSection":"lat.md/chat-commands#Slash command execution#Central command router#Model commands","file":"lat.md/chat-commands","line":245},{"target":"src/renderer/src/screens/Chat/slash/SlashCommandIcon.tsx#SlashCommandIcon","fromSection":"lat.md/chat-commands#Slash command execution#Central command router#Command icons","file":"lat.md/chat-commands","line":249},{"target":"src/renderer/src/screens/Chat/slash/SlashCommandIcon.tsx#registerCustomSlashSvg","fromSection":"lat.md/chat-commands#Slash command execution#Central command router#Command icons","file":"lat.md/chat-commands","line":251},{"target":"src/renderer/src/screens/Chat/ChatInput.tsx#ChatInput","fromSection":"lat.md/chat-commands#Slash command execution#Central command router#Command icons","file":"lat.md/chat-commands","line":253},{"target":"src/renderer/src/screens/Chat/slash/virtualSlashCommands.ts#createSlashCommandVirtualLayout","fromSection":"lat.md/chat-commands#Slash command execution#Central command router#Command icons","file":"lat.md/chat-commands","line":257},{"target":"src/renderer/src/screens/Chat/dashboardEventAdapter.ts#appendClarifyRequest","fromSection":"lat.md/chat-commands#Slash command execution#Dashboard clarification cards","file":"lat.md/chat-commands","line":263},{"target":"src/renderer/src/screens/Chat/Chat.tsx#Chat","fromSection":"lat.md/chat-commands#Slash command execution#Dashboard clarification cards","file":"lat.md/chat-commands","line":263},{"target":"src/renderer/src/screens/Chat/ClarifyCard.tsx","fromSection":"lat.md/chat-commands#Slash command execution#Dashboard clarification cards","file":"lat.md/chat-commands","line":263},{"target":"src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport","fromSection":"lat.md/chat-commands#Slash command execution#Dashboard clarification cards","file":"lat.md/chat-commands","line":263},{"target":"dashboard-clarify","fromSection":"lat.md/chat-commands#Slash command execution#Dashboard clarification cards","file":"lat.md/chat-commands","line":263},{"target":"server-requests#Batch clarification","fromSection":"lat.md/chat-commands#Slash command execution#Dashboard clarification cards","file":"lat.md/chat-commands","line":267}],"paragraphs":[{"markdown":"Typed slash commands (`/compact`, `/compress`, `/reset`, `/web`, …) are run through the gateway's command pipeline, not submitted to the model as plain prompt text. This is what makes them _do_ something instead of being echoed back as prose.","startLine":3,"endLine":3,"text":"Typed slash commands (/compact, /compress, /reset, /web, …) are run through the gateway's command pipeline, not submitted to the model as plain prompt text. This is what makes them do something instead of being echoed back as prose."},{"markdown":"The desktop talks to the hermes-agent gateway over JSON-RPC. A normal message goes via `prompt.submit`, which the gateway treats as a user turn — so a literal `/compact` reaches the model and comes back as text. Real commands must instead go through `slash.exec` (registry-backed worker) with a `command.dispatch` fallback for commands that resolve to an alias, plugin, skill, or an agent prompt.","startLine":5,"endLine":5,"text":"The desktop talks to the hermes-agent gateway over JSON-RPC. A normal message goes via prompt.submit, which the gateway treats as a user turn — so a literal /compact reaches the model and comes back as text. Real commands must instead go through slash.exec (registry-backed worker) with a command.dispatch fallback for commands that resolve to an alias, plugin, skill, or an agent prompt."},{"markdown":"**Profile scoping over the unified SSH dashboard.** In SSH mode one machine dashboard serves every profile (see [[main-process#SSH dashboard transport]]), so chat calls must carry the active `profile` or the gateway runs them under its launch profile (`default`) — the agent would then answer as `default` even when a named profile is selected. [[src/main/remote-sessions.ts#RemoteSessionConfig]]`.profile` scopes the `/api/*` HTTP ops, and the `/api/ws` chat client passes `profile` on `session.create`/`session.resume` **and** `prompt.submit`/`prompt.background` ([[src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#submitDashboardPromptWithRecovery]]); `session.create` builds the agent and persists against that profile's `HERMES_HOME`/`state.db`, and each turn re-binds it. Omitted/`default` → the launch profile (unchanged for local and per-profile-remote setups).","startLine":7,"endLine":7,"text":"Profile scoping over the unified SSH dashboard. In SSH mode one machine dashboard serves every profile (see main-process#SSH dashboard transport), so chat calls must carry the active profile or the gateway runs them under its launch profile (default) — the agent would then answer as default even when a named profile is selected. src/main/remote-sessions.ts#RemoteSessionConfig.profile scopes the /api/* HTTP ops, and the /api/ws chat client passes profile on session.create/session.resume and prompt.submit/prompt.background (src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#submitDashboardPromptWithRecovery); session.create builds the agent and persists against that profile's HERMES_HOME/state.db, and each turn re-binds it. Omitted/default → the launch profile (unchanged for local and per-profile-remote setups)."},{"markdown":"The pure routing logic lives in [[src/renderer/src/screens/Chat/slashExec.ts#executeSlash]]: try `slash.exec`, accept either rendered output or a structured dispatch result, and on rejection fall back to `command.dispatch`, returning `done`, `send`, or `error`.","startLine":11,"endLine":11,"text":"The pure routing logic lives in src/renderer/src/screens/Chat/slashExec.ts#executeSlash: try slash.exec, accept either rendered output or a structured dispatch result, and on rejection fall back to command.dispatch, returning done, send, or error."},{"markdown":"The name/argument split is done by [[src/renderer/src/screens/Chat/slashExec.ts#parseSlash]], which matches with the dotAll flag so a command's argument may span multiple lines (e.g. a multi-line `/remember` note) — an empty name is what `executeSlash` rejects as an empty command, so a multi-line body must not collapse the match.","startLine":13,"endLine":13,"text":"The name/argument split is done by src/renderer/src/screens/Chat/slashExec.ts#parseSlash, which matches with the dotAll flag so a command's argument may span multiple lines (e.g. a multi-line /remember note) — an empty name is what executeSlash rejects as an empty command, so a multi-line body must not collapse the match."},{"markdown":"It mirrors hermes-agent's reference client (`web/src/lib/slashExec.ts`) so every front-end implements the same contract. Pending-input commands such as `/learn` can return `{type: \"send\"}` directly from `slash.exec`; that prompt still passes through the central model-submission path.","startLine":15,"endLine":15,"text":"It mirrors hermes-agent's reference client (web/src/lib/slashExec.ts) so every front-end implements the same contract. Pending-input commands such as /learn can return {type: \"send\"} directly from slash.exec; that prompt still passes through the central model-submission path."},{"markdown":"Every typed slash command is resolved through the merged catalog before execution. Ownership is explicit (`target: \"desktop\" | \"agent\" | \"model\"`); display categories such as `info` do not determine routing.","startLine":19,"endLine":19,"text":"Every typed slash command is resolved through the merged catalog before execution. Ownership is explicit (target: \"desktop\" | \"agent\" | \"model\"); display categories such as info do not determine routing."},{"markdown":"Desktop-only commands delegate to local renderer handlers, Agent commands use the gateway command pipeline, and model commands build a prompt through the shared model-submission formatter. The legacy transport reports Agent commands as unavailable instead of sending raw `/…` text to the model.","startLine":21,"endLine":21,"text":"Desktop-only commands delegate to local renderer handlers, Agent commands use the gateway command pipeline, and model commands build a prompt through the shared model-submission formatter. The legacy transport reports Agent commands as unavailable instead of sending raw /… text to the model."},{"markdown":"Slash commands run on the gateway's **persistent slash-worker subprocess**, concurrent with any in-flight turn — so they respond instantly and must NOT sit in the busy queue behind a running turn (only plain prompts queue).","startLine":25,"endLine":25,"text":"Slash commands run on the gateway's persistent slash-worker subprocess, concurrent with any in-flight turn — so they respond instantly and must NOT sit in the busy queue behind a running turn (only plain prompts queue)."},{"markdown":"`handleSubmitOrQueue` in [[src/renderer/src/screens/Chat/Chat.tsx]] dispatches every `/…` input immediately to the central router. Desktop and slash-worker commands can complete concurrently; model commands and Agent `send`/skill directives are formatted once and queued when the main model turn is busy.","startLine":27,"endLine":27,"text":"handleSubmitOrQueue in src/renderer/src/screens/Chat/Chat.tsx dispatches every /… input immediately to the central router. Desktop and slash-worker commands can complete concurrently; model commands and Agent send/skill directives are formatted once and queued when the main model turn is busy."},{"markdown":"Because no global loading state is set, the slash branch shows its own feedback: it inserts an in-place `⏳ Running …` agent bubble, buffers the pipeline output, and replaces that bubble with the result (or `error: …`) when the command resolves — otherwise a slow or unreachable gateway would leave the user staring at nothing. Handled UI actions without output silently remove the pending bubble without leaving conversation artifacts.","startLine":29,"endLine":29,"text":"Because no global loading state is set, the slash branch shows its own feedback: it inserts an in-place ⏳ Running … agent bubble, buffers the pipeline output, and replaces that bubble with the result (or error: …) when the command resolves — otherwise a slow or unreachable gateway would leave the user staring at nothing. Handled UI actions without output silently remove the pending bubble without leaving conversation artifacts."},{"markdown":"Every dashboard turn first connects a JSON-RPC WebSocket to the gateway; that handshake must be time-bounded or a stalled socket wedges the whole transport with no error and no fallback (issue #718).","startLine":33,"endLine":33,"text":"Every dashboard turn first connects a JSON-RPC WebSocket to the gateway; that handshake must be time-bounded or a stalled socket wedges the whole transport with no error and no fallback (issue #718)."},{"markdown":"[[src/renderer/src/screens/Chat/dashboardGatewayClient.ts#DashboardGatewayClient#connect]] resolves on `open`, rejects on `error` or an early `close`, **and** rejects on a connect-timeout (default 10s). A WebSocket stuck in `CONNECTING` — TCP accepted but the upgrade never completing, e.g. when a busy renderer starves the handshake — fires none of those events on its own, so without the timer the connect promise never settles. When it never settles, `ensureClient` in [[src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport]] never resolves, its cached `connectingRef` promise poisons every later send, `setIsLoading(false)` never runs, and the user sees a permanent loading spinner. The timeout makes the promise reject so auto mode falls back to the legacy HTTP transport (and explicit-dashboard mode surfaces a real error) instead of hanging. Per-request calls are separately bounded by their own 30s timeout.","startLine":35,"endLine":35,"text":"src/renderer/src/screens/Chat/dashboardGatewayClient.ts#DashboardGatewayClient#connect resolves on open, rejects on error or an early close, and rejects on a connect-timeout (default 10s). A WebSocket stuck in CONNECTING — TCP accepted but the upgrade never completing, e.g. when a busy renderer starves the handshake — fires none of those events on its own, so without the timer the connect promise never settles. When it never settles, ensureClient in src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport never resolves, its cached connectingRef promise poisons every later send, setIsLoading(false) never runs, and the user sees a permanent loading spinner. The timeout makes the promise reject so auto mode falls back to the legacy HTTP transport (and explicit-dashboard mode surfaces a real error) instead of hanging. Per-request calls are separately bounded by their own 30s timeout."},{"markdown":"When a dashboard is available, chat goes through `/api/ws` **only** — never the `/v1` fallback, which 405s over the dashboard tunnel.","startLine":39,"endLine":39,"text":"When a dashboard is available, chat goes through /api/ws only — never the /v1 fallback, which 405s over the dashboard tunnel."},{"markdown":"This matches the reference `apps/desktop`, which has no `/v1` chat path at all (its `use-prompt-actions.ts` submits via `requestGateway('prompt.submit', …)` with a busy-retry). The fork's main-process `/v1` path (`sendMessageViaApi`/`sendMessageViaRuns`) exists solely for genuine gateway-only remotes; falling to it while a dashboard is up POSTs `/v1` to the dashboard tunnel — which has no `/v1` → **405**.","startLine":41,"endLine":41,"text":"This matches the reference apps/desktop, which has no /v1 chat path at all (its use-prompt-actions.ts submits via requestGateway('prompt.submit', …) with a busy-retry). The fork's main-process /v1 path (sendMessageViaApi/sendMessageViaRuns) exists solely for genuine gateway-only remotes; falling to it while a dashboard is up POSTs /v1 to the dashboard tunnel — which has no /v1 → 405."},{"markdown":"So `ensureClient` distinguishes two failures: a **genuinely absent** dashboard (`startDashboard` → `running:false`) latches the negative flag and (auto mode) drops to legacy gateway `/v1`; a **transient** WS drop while the dashboard is up (a \"socket hang up\" from a tunnel blip) instead **retries the connect** (up to 3×, re-running `startDashboard` each time to re-establish the SSH tunnel). If it still can't connect, it throws a `dashboardWasReachable`-tagged error so `sendMessage` **fails the turn for the user to retry** rather than 405-ing on `/v1`.","startLine":43,"endLine":43,"text":"So ensureClient distinguishes two failures: a genuinely absent dashboard (startDashboard → running:false) latches the negative flag and (auto mode) drops to legacy gateway /v1; a transient WS drop while the dashboard is up (a \"socket hang up\" from a tunnel blip) instead retries the connect (up to 3×, re-running startDashboard each time to re-establish the SSH tunnel). If it still can't connect, it throws a dashboardWasReachable-tagged error so sendMessage fails the turn for the user to retry rather than 405-ing on /v1."},{"markdown":"On `message.complete` the desktop reconciles the text streamed via `message.delta` with the turn's `final_response`, because a last-turn-only final would otherwise clobber text streamed before a tool call (#746).","startLine":47,"endLine":47,"text":"On message.complete the desktop reconciles the text streamed via message.delta with the turn's final_response, because a last-turn-only final would otherwise clobber text streamed before a tool call (#746)."},{"markdown":"[[src/renderer/src/screens/Chat/dashboardEventAdapter.ts#completeAssistantWithFinalText]] rewrites the last assistant bubble through [[src/renderer/src/screens/Chat/dashboardEventAdapter.ts#mergeStreamedWithFinal]], which compares whitespace-insensitively and: uses the final text when it already contains the streamed text; keeps the streamed text when it contains the final (preserving pre-tool-call content); replaces a **lossy chunk-dropped stream** with the final text when [[src/renderer/src/screens/Chat/lossyText.ts#isLossyChunkCopy]] recognises the streamed content as a chunk-dropped copy of the final (the upstream tagging alternate chunks as `reasoning` leaves the content stream a garbled subset like \"! What are we working on?\" for \"Hey! What are we working on today?\"; concatenating stacked the partial above the clean answer in one bubble: the matcher requires contiguous runs of ≥3 chars (≥6 for CJK/Japanese/Korean text, where a run this short is much weaker evidence of continuity) plus ≥12-char / ≥30%-coverage guards, so a pre-tool-call segment whose characters merely embed as scattered fragments still stacks); stitches a re-streamed boundary by dropping the duplicated word-aligned seam (rejecting coincidental mid-word overlaps); replaces a garbled re-stream with the final text when the two converge on a substantial common suffix (a corrupted-prefix delta, e.g. a mangled CJK stream, that ends the same sentence as the clean final, rather than the disjoint pre-tool-call + answer pair); and otherwise concatenates the two with a blank-line separator so segments never run together. On the remote/SSH path deltas are not rendered (`renderAssistantDeltas: false`), so the bubble starts empty and the final text is used verbatim.","startLine":49,"endLine":49,"text":"src/renderer/src/screens/Chat/dashboardEventAdapter.ts#completeAssistantWithFinalText rewrites the last assistant bubble through src/renderer/src/screens/Chat/dashboardEventAdapter.ts#mergeStreamedWithFinal, which compares whitespace-insensitively and: uses the final text when it already contains the streamed text; keeps the streamed text when it contains the final (preserving pre-tool-call content); replaces a lossy chunk-dropped stream with the final text when src/renderer/src/screens/Chat/lossyText.ts#isLossyChunkCopy recognises the streamed content as a chunk-dropped copy of the final (the upstream tagging alternate chunks as reasoning leaves the content stream a garbled subset like \"! What are we working on?\" for \"Hey! What are we working on today?\"; concatenating stacked the partial above the clean answer in one bubble: the matcher requires contiguous runs of ≥3 chars (≥6 for CJK/Japanese/Korean text, where a run this short is much weaker evidence of continuity) plus ≥12-char / ≥30%-coverage guards, so a pre-tool-call segment whose characters merely embed as scattered fragments still stacks); stitches a re-streamed boundary by dropping the duplicated word-aligned seam (rejecting coincidental mid-word overlaps); replaces a garbled re-stream with the final text when the two converge on a substantial common suffix (a corrupted-prefix delta, e.g. a mangled CJK stream, that ends the same sentence as the clean final, rather than the disjoint pre-tool-call + answer pair); and otherwise concatenates the two with a blank-line separator so segments never run together. On the remote/SSH path deltas are not rendered (renderAssistantDeltas: false), so the bubble starts empty and the final text is used verbatim."},{"markdown":"Lossy-copy admission and run matching count Unicode code points consistently. Supplementary-plane characters cannot bypass the minimum 12-character length or 30% coverage by occupying two UTF-16 code units.","startLine":53,"endLine":53,"text":"Lossy-copy admission and run matching count Unicode code points consistently. Supplementary-plane characters cannot bypass the minimum 12-character length or 30% coverage by occupying two UTF-16 code units."},{"markdown":"[[src/renderer/src/screens/Chat/lossyText.test.ts]] rejects an 11-character partial and a 12-character partial covering less than 30%, while retaining acceptance at the exact 12-character/30% boundary. This protects distinct streamed completion and reasoning text from false deduplication.","startLine":55,"endLine":55,"text":"src/renderer/src/screens/Chat/lossyText.test.ts rejects an 11-character partial and a 12-character partial covering less than 30%, while retaining acceptance at the exact 12-character/30% boundary. This protects distinct streamed completion and reasoning text from false deduplication."},{"markdown":"Legacy gateway completion appends only a confirmed missing suffix, accepting whitespace drift without replacing text already emitted to the renderer.","startLine":59,"endLine":59,"text":"Legacy gateway completion appends only a confirmed missing suffix, accepting whitespace drift without replacing text already emitted to the renderer."},{"markdown":"[[src/main/tui-gateway-stream.ts#gatewayCompletionSuffix]] compares the complete streamed prefix to the final text, allowing whitespace runs to differ while retaining original final offsets. Existing stream separators are reused. Unrelated, non-prefix or already complete responses append nothing, preventing duplicated replies.","startLine":61,"endLine":61,"text":"src/main/tui-gateway-stream.ts#gatewayCompletionSuffix compares the complete streamed prefix to the final text, allowing whitespace runs to differ while retaining original final offsets. Existing stream separators are reused. Unrelated, non-prefix or already complete responses append nothing, preventing duplicated replies."},{"markdown":"Actual exported-helper fixtures recover missing tails across trailing spaces, newlines, tabs, interior whitespace changes and Unicode text while preserving the text already streamed.","startLine":65,"endLine":65,"text":"Actual exported-helper fixtures recover missing tails across trailing spaces, newlines, tabs, interior whitespace changes and Unicode text while preserving the text already streamed."},{"markdown":"Completed whitespace variants, unrelated final responses and mid-word conflicts after a streamed separator do not append text or repeat the answer.","startLine":69,"endLine":69,"text":"Completed whitespace variants, unrelated final responses and mid-word conflicts after a streamed separator do not append text or repeat the answer."},{"markdown":"A matched assistant database row may replace an incomplete live row with its confirmed longer continuation while retaining the live identity and metadata.","startLine":73,"endLine":73,"text":"A matched assistant database row may replace an incomplete live row with its confirmed longer continuation while retaining the live identity and metadata."},{"markdown":"[[src/renderer/src/screens/Chat/sessionHistory.ts#reconcileStreamedWithDb]] keeps its existing row-matching rules. For a matched assistant bubble, normalized readable database content must strictly extend the complete live prefix before it replaces content. Database attachment wrappers alone, divergent replies, shorter snapshots and user submissions retain their live text. This recovery reads canonical database content rather than treating an unrelated final stream payload as authoritative.","startLine":75,"endLine":75,"text":"src/renderer/src/screens/Chat/sessionHistory.ts#reconcileStreamedWithDb keeps its existing row-matching rules. For a matched assistant bubble, normalized readable database content must strictly extend the complete live prefix before it replaces content. Database attachment wrappers alone, divergent replies, shorter snapshots and user submissions retain their live text. This recovery reads canonical database content rather than treating an unrelated final stream payload as authoritative."},{"markdown":"Actual reconciliation tests restore a substantive missing final sentence despite whitespace drift, preserving the live row ID and adopting its recorded database timestamp.","startLine":79,"endLine":79,"text":"Actual reconciliation tests restore a substantive missing final sentence despite whitespace drift, preserving the live row ID and adopting its recorded database timestamp."},{"markdown":"File wrappers and image markers can increase raw database length without adding readable reply content; these additions do not overwrite the live response.","startLine":83,"endLine":83,"text":"File wrappers and image markers can increase raw database length without adding readable reply content; these additions do not overwrite the live response."},{"markdown":"A shared match-key prefix alone does not authorize a content replacement. Divergent endings and older, shorter database snapshots leave streamed text intact.","startLine":87,"endLine":87,"text":"A shared match-key prefix alone does not authorize a content replacement. Divergent endings and older, shorter database snapshots leave streamed text intact."},{"markdown":"A longer database record cannot rewrite an optimistic user submission, preserving its original visible request and attachment presentation.","startLine":91,"endLine":91,"text":"A longer database record cannot rewrite an optimistic user submission, preserving its original visible request and attachment presentation."},{"markdown":"A live reply cut off before the 200-character match key never meets its database row. The unmatched database reply that strictly extends it in the same turn completes the live row once.","startLine":95,"endLine":95,"text":"A live reply cut off before the 200-character match key never meets its database row. The unmatched database reply that strictly extends it in the same turn completes the live row once."},{"markdown":"[[src/renderer/src/screens/Chat/sessionHistory.ts#foldShortPartialReplies]] keeps the live id and position. Replies in other turns, across a tool call, or that diverge stay separate.","startLine":97,"endLine":97,"text":"src/renderer/src/screens/Chat/sessionHistory.ts#foldShortPartialReplies keeps the live id and position. Replies in other turns, across a tool call, or that diverge stay separate."},{"markdown":"A Dashboard busy refusal ends only the attempted desktop turn. Its saved conversation and runtime remain available for retry after the upstream work finishes.","startLine":101,"endLine":101,"text":"A Dashboard busy refusal ends only the attempted desktop turn. Its saved conversation and runtime remain available for retry after the upstream work finishes."},{"markdown":"[[src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport]] recognizes the gateway's `session busy` refusal, including command-specific messages. It settles the attempted turn with an error without closing or recreating its runtime or automatically interrupting the upstream active turn. A retry rechecks the selected model on the same runtime. Actual failed provider turns still use the existing clean-runtime recovery path.","startLine":103,"endLine":103,"text":"src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport recognizes the gateway's session busy refusal, including command-specific messages. It settles the attempted turn with an error without closing or recreating its runtime or automatically interrupting the upstream active turn. A retry rechecks the selected model on the same runtime. Actual failed provider turns still use the existing clean-runtime recovery path."},{"markdown":"Actual Local, SSH and Remote hook tests resume a saved conversation, receive a busy prompt refusal and retry on the same runtime and profile without creating, closing or interrupting a session.","startLine":107,"endLine":107,"text":"Actual Local, SSH and Remote hook tests resume a saved conversation, receive a busy prompt refusal and retry on the same runtime and profile without creating, closing or interrupting a session."},{"markdown":"A busy model command before prompt submission preserves the existing runtime; retrying applies the model again and submits into the saved conversation.","startLine":111,"endLine":111,"text":"A busy model command before prompt submission preserves the existing runtime; retrying applies the model again and submits into the saved conversation."},{"markdown":"A busy submission can overlap a displayed approval from upstream work. Retiring that attempted UI turn expires its stale controls without sending `session.interrupt` to the still-running session.","startLine":115,"endLine":115,"text":"A busy submission can overlap a displayed approval from upstream work. Retiring that attempted UI turn expires its stale controls without sending session.interrupt to the still-running session."},{"markdown":"`handleGatewayEvent` in [[src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport]] applies stream events against a synchronous `messagesRef`, not React state, because state lags a render behind and each successive delta must build on the previous one.","startLine":119,"endLine":119,"text":"handleGatewayEvent in src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport applies stream events against a synchronous messagesRef, not React state, because state lags a render behind and each successive delta must build on the previous one."},{"markdown":"The ref is the write-through transcript ref owned by [[src/renderer/src/screens/Chat/hooks/useTranscriptState.ts#useTranscriptState]] and shared with every transcript writer through its wrapped `setMessages`: the wrapper resolves functional updaters against the ref _at dispatch time_ and writes the result back before dispatching the value to React. This is the correctness invariant that replaced the old adopt-back effect. Committed React state can be up to a frame behind the ref while deltas coalesce, so a writer resolved against committed state (a `/btw` user turn, `handleClear`, a clarify card resolving, failure marking) would fork from a pre-delta snapshot and silently drop the in-flight chunks — the coalesced twin of #757. With the write-through wrapper, every writer builds on the newest transcript and the ref always equals the newest dispatched-or-streamed array.","startLine":121,"endLine":121,"text":"The ref is the write-through transcript ref owned by src/renderer/src/screens/Chat/hooks/useTranscriptState.ts#useTranscriptState and shared with every transcript writer through its wrapped setMessages: the wrapper resolves functional updaters against the ref at dispatch time and writes the result back before dispatching the value to React. This is the correctness invariant that replaced the old adopt-back effect. Committed React state can be up to a frame behind the ref while deltas coalesce, so a writer resolved against committed state (a /btw user turn, handleClear, a clarify card resolving, failure marking) would fork from a pre-delta snapshot and silently drop the in-flight chunks — the coalesced twin of #757. With the write-through wrapper, every writer builds on the newest transcript and the ref always equals the newest dispatched-or-streamed array."},{"markdown":"Delta commits are coalesced: high-frequency events (`message.delta`, `thinking.delta`, `reasoning.delta`, `tool.progress`, `tool.generating`) update the ref and schedule one `setMessages(messagesRef.current)` per animation frame, while lifecycle events (start/complete/clarify/tool boundaries) cancel any pending frame and commit immediately, so `isLoading`/approval state never observes a stale transcript. Because the flush publishes the ref rather than a pinned snapshot, a frame that fires after another writer took over republishes (or advances to) that newer state — it can never resurrect an older transcript. Nothing may call the raw state setter or re-adopt committed state into the ref. Specified by the delta-coalescing tests in [[src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.test.tsx]].","startLine":123,"endLine":123,"text":"Delta commits are coalesced: high-frequency events (message.delta, thinking.delta, reasoning.delta, tool.progress, tool.generating) update the ref and schedule one setMessages(messagesRef.current) per animation frame, while lifecycle events (start/complete/clarify/tool boundaries) cancel any pending frame and commit immediately, so isLoading/approval state never observes a stale transcript. Because the flush publishes the ref rather than a pinned snapshot, a frame that fires after another writer took over republishes (or advances to) that newer state — it can never resurrect an older transcript. Nothing may call the raw state setter or re-adopt committed state into the ref. Specified by the delta-coalescing tests in src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.test.tsx."},{"markdown":"Streamed reasoning and tool calls are folded into compact, collapsible transcript rows rather than stacked bubbles, so a turn with heavy thinking or many tool calls stays scannable.","startLine":127,"endLine":127,"text":"Streamed reasoning and tool calls are folded into compact, collapsible transcript rows rather than stacked bubbles, so a turn with heavy thinking or many tool calls stays scannable."},{"markdown":"[[src/renderer/src/screens/Chat/HistoryRow.tsx#ReasoningRow]] renders the `Thought` / `Thinking…` row and [[src/renderer/src/screens/Chat/HistoryRow.tsx#ToolActivityGroup]] folds a contiguous run of tool calls/results into one row titled by [[src/renderer/src/screens/Chat/HistoryRow.tsx#toolActivityGroupTitle]]. Each row is collapsed by default and borderless (Codex-style): dim at rest, it brightens and reveals an expand chevron beside the title on hover/focus, and clicking toggles the body open. While the turn is still streaming the leading icon is a thinking-orbs [[loading-indicators|OrbLoader]] (`solving` for reasoning, `working` for tools); once finished it shows the brain/tool glyph.","startLine":129,"endLine":129,"text":"src/renderer/src/screens/Chat/HistoryRow.tsx#ReasoningRow renders the Thought / Thinking… row and src/renderer/src/screens/Chat/HistoryRow.tsx#ToolActivityGroup folds a contiguous run of tool calls/results into one row titled by src/renderer/src/screens/Chat/HistoryRow.tsx#toolActivityGroupTitle. Each row is collapsed by default and borderless (Codex-style): dim at rest, it brightens and reveals an expand chevron beside the title on hover/focus, and clicking toggles the body open. While the turn is still streaming the leading icon is a thinking-orbs OrbLoader (solving for reasoning, working for tools); once finished it shows the brain/tool glyph."},{"markdown":"The live reasoning stream is best-effort — dropped delta chunks leave the streamed row garbled — while state.db holds the canonical text. The DB refresh must collapse the two, or the user sees both stacked in one Thought block.","startLine":133,"endLine":133,"text":"The live reasoning stream is best-effort — dropped delta chunks leave the streamed row garbled — while state.db holds the canonical text. The DB refresh must collapse the two, or the user sees both stacked in one Thought block."},{"markdown":"The observed symptom: a Thought block showing \"moon-k3 … ous\" (lossy live preview) above \"moonshotai/kimi-k3 … nous\" (canonical DB row) for the same thought.","startLine":135,"endLine":135,"text":"The observed symptom: a Thought block showing \"moon-k3 … ous\" (lossy live preview) above \"moonshotai/kimi-k3 … nous\" (canonical DB row) for the same thought."},{"markdown":"Because the garbled text can't match the DB row's text-based reconciliation key, [[src/renderer/src/screens/Chat/sessionHistory.ts#reconcileStreamedWithDb]] ends with [[src/renderer/src/screens/Chat/sessionHistory.ts#dropLossyStreamedReasoning]]: a streamed reasoning row is dropped when [[src/renderer/src/screens/Chat/lossyText.ts#isLossyChunkCopy]] recognises it as a chunk-dropped copy of a DB reasoning row (`db-r-<id>`) in the **same turn**. A dropped-chunks preview is by construction a concatenation of contiguous runs of the canonical text; the matcher's run (≥3 chars, ≥6 for CJK/Japanese/Korean text) and length/coverage (≥12 chars, ≥30%) guards separate \"same thought, chunks missing\" from a genuinely distinct short segment whose characters merely embed as scattered fragments.","startLine":137,"endLine":137,"text":"Because the garbled text can't match the DB row's text-based reconciliation key, src/renderer/src/screens/Chat/sessionHistory.ts#reconcileStreamedWithDb ends with src/renderer/src/screens/Chat/sessionHistory.ts#dropLossyStreamedReasoning: a streamed reasoning row is dropped when src/renderer/src/screens/Chat/lossyText.ts#isLossyChunkCopy recognises it as a chunk-dropped copy of a DB reasoning row (db-r-<id>) in the same turn. A dropped-chunks preview is by construction a concatenation of contiguous runs of the canonical text; the matcher's run (≥3 chars, ≥6 for CJK/Japanese/Korean text) and length/coverage (≥12 chars, ≥30%) guards separate \"same thought, chunks missing\" from a genuinely distinct short segment whose characters merely embed as scattered fragments."},{"markdown":"A streamed reasoning row recognised as a chunk-dropped copy of the same turn's DB reasoning row disappears from the merge; only the canonical DB text renders. A short thought whose characters embed only as scattered fragments is kept.","startLine":141,"endLine":141,"text":"A streamed reasoning row recognised as a chunk-dropped copy of the same turn's DB reasoning row disappears from the merge; only the canonical DB text renders. A short thought whose characters embed only as scattered fragments is kept."},{"markdown":"A second live reasoning segment that is not a lossy duplicate of any DB row in the turn (multi-segment thinking around tool calls) is kept alongside the reconciled first segment.","startLine":145,"endLine":145,"text":"A second live reasoning segment that is not a lossy duplicate of any DB row in the turn (multi-segment thinking around tool calls) is kept alongside the reconciled first segment."},{"markdown":"The chunk-copy check never crosses turns: a live preview in turn 2 is kept even when its text would match turn 1's canonical reasoning, so repeated questions can't cross-cancel live rows.","startLine":149,"endLine":149,"text":"The chunk-copy check never crosses turns: a live preview in turn 2 is kept even when its text would match turn 1's canonical reasoning, so repeated questions can't cross-cancel live rows."},{"markdown":"Remote and SSH history preserve tool calls returned as decoded REST arrays or legacy JSON strings, so reopening a conversation retains its tool activity alongside the final assistant text.","startLine":153,"endLine":153,"text":"Remote and SSH history preserve tool calls returned as decoded REST arrays or legacy JSON strings, so reopening a conversation retains its tool activity alongside the final assistant text."},{"markdown":"[[src/main/remote-sessions.ts#normalizeMessageRow]] serializes only array-shaped `tool_calls` into the existing database-row representation. [[src/main/sessions.ts#expandRowsToHistory]] then applies the shared parser and preserves call IDs, names, arguments and matching tool results. Unrelated top-level objects, numbers and booleans do not become tool calls.","startLine":155,"endLine":155,"text":"src/main/remote-sessions.ts#normalizeMessageRow serializes only array-shaped tool_calls into the existing database-row representation. src/main/sessions.ts#expandRowsToHistory then applies the shared parser and preserves call IDs, names, arguments and matching tool results. Unrelated top-level objects, numbers and booleans do not become tool calls."},{"markdown":"Real REST fixtures produce identical history from decoded arrays and legacy strings, including clarification arguments, matching tool results and the final assistant message.","startLine":159,"endLine":159,"text":"Real REST fixtures produce identical history from decoded arrays and legacy strings, including clarification arguments, matching tool results and the final assistant message."},{"markdown":"Malformed top-level tool-call values cannot create activity rows or remove the remaining user, result and assistant history.","startLine":163,"endLine":163,"text":"Malformed top-level tool-call values cannot create activity rows or remove the remaining user, result and assistant history."},{"markdown":"Each user/assistant bubble reveals a relative \"time ago\" label on row hover, so the transcript stays uncluttered at rest but is still scrutable when a user wants to know _when_ something was said.","startLine":167,"endLine":167,"text":"Each user/assistant bubble reveals a relative \"time ago\" label on row hover, so the transcript stays uncluttered at rest but is still scrutable when a user wants to know when something was said."},{"markdown":"The canonical time comes from state.db: [[src/renderer/src/screens/Chat/sessionHistory.ts#dbItemsToChatMessages]] copies each row's `timestamp` onto the `ChatBubbleMessage`, and [[src/renderer/src/screens/Chat/sessionHistory.ts#reconcileAfterDbRefresh|the end-of-stream reconcile]] adopts it onto the matching streamed bubble (via `mergeDbMetadataIntoStreamed`) so a live turn picks up its real time after refresh without remounting. state.db stores times in **seconds**, so `toEpochMs` in MessageRow scales any sub-`1e12` value up to milliseconds before use (otherwise it renders as ~Jan 1970). [[src/renderer/src/screens/Chat/MessageRow.tsx#formatBubbleTime]] builds the label with date-fns `formatDistanceToNowStrict` (e.g. \"5 minutes ago\", \"just now\" under 10s), with `formatBubbleTimeAbsolute` supplying the exact date/time as the `<time>` element's `title`/`dateTime`. The `.chat-message:hover .chat-bubble-time` CSS fades it in below the bubble, anchored to `.chat-message` because `.chat-bubble`'s own `overflow` would clip it.","startLine":169,"endLine":169,"text":"The canonical time comes from state.db: src/renderer/src/screens/Chat/sessionHistory.ts#dbItemsToChatMessages copies each row's timestamp onto the ChatBubbleMessage, and the end-of-stream reconcile adopts it onto the matching streamed bubble (via mergeDbMetadataIntoStreamed) so a live turn picks up its real time after refresh without remounting. state.db stores times in seconds, so toEpochMs in MessageRow scales any sub-1e12 value up to milliseconds before use (otherwise it renders as ~Jan 1970). src/renderer/src/screens/Chat/MessageRow.tsx#formatBubbleTime builds the label with date-fns formatDistanceToNowStrict (e.g. \"5 minutes ago\", \"just now\" under 10s), with formatBubbleTimeAbsolute supplying the exact date/time as the <time> element's title/dateTime. The .chat-message:hover .chat-bubble-time CSS fades it in below the bubble, anchored to .chat-message because .chat-bubble's own overflow would clip it."},{"markdown":"A few non-local commands have dedicated desktop handling and must NOT be diverted to the gateway slash pipeline, or they'd lose their behaviour.","startLine":173,"endLine":173,"text":"A few non-local commands have dedicated desktop handling and must NOT be diverted to the gateway slash pipeline, or they'd lose their behaviour."},{"markdown":"The legacy approval responses `/approve` and `/deny` (the `RENDERER_NATIVE_SLASH` set) are excluded from the pipeline and sent as prompt-level input. They remain a compatibility path for text-only backends; structured gateway approvals use the flow below.","startLine":175,"endLine":175,"text":"The legacy approval responses /approve and /deny (the RENDERER_NATIVE_SLASH set) are excluded from the pipeline and sent as prompt-level input. They remain a compatibility path for text-only backends; structured gateway approvals use the flow below."},{"markdown":"Dangerous commands pause the current turn until the user explicitly allows or denies them; the desktop never auto-approves or replays a prompt after an approval request.","startLine":179,"endLine":179,"text":"Dangerous commands pause the current turn until the user explicitly allows or denies them; the desktop never auto-approves or replays a prompt after an approval request."},{"markdown":"Legacy response acknowledgements may follow turn completion; lifecycle regression coverage is documented in [[approval-completion]]. Current Agent requests use the matching-ID response path in [[server-requests#Matching request replies]].","startLine":181,"endLine":181,"text":"Legacy response acknowledgements may follow turn completion; lifecycle regression coverage is documented in approval-completion. Current Agent requests use the matching-ID response path in server-requests#Matching request replies."},{"markdown":"[[src/shared/chat-approval.ts#normalizeApprovalRequest]] limits choices to the gateway's offered permissions and preserves a deny path. Dashboard chat renders [[src/renderer/src/screens/Chat/ApprovalCard.tsx#ApprovalCard]] from a normalized `approval.request`; cards queue in arrival order with an in-flight guard.","startLine":183,"endLine":183,"text":"src/shared/chat-approval.ts#normalizeApprovalRequest limits choices to the gateway's offered permissions and preserves a deny path. Dashboard chat renders src/renderer/src/screens/Chat/ApprovalCard.tsx#ApprovalCard from a normalized approval.request; cards queue in arrival order with an in-flight guard."},{"markdown":"For legacy Agent events, [[src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport]] sends the gateway-issued `request_id` and runtime session ID through `approval.respond`. Only an acknowledgement resolving exactly one request succeeds; a missing ID or unresolved acknowledgement invalidates the cards and interrupts the turn. Current Agent requests instead receive a JSON-RPC result with their original `srq-*` ID on the originating socket. The adapter's success result confirms socket delivery, not a separate backend acknowledgement. Cancellation, settled-ID fencing and reconnect restoration follow [[server-requests]].","startLine":185,"endLine":185,"text":"For legacy Agent events, src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport sends the gateway-issued request_id and runtime session ID through approval.respond. Only an acknowledgement resolving exactly one request succeeds; a missing ID or unresolved acknowledgement invalidates the cards and interrupts the turn. Current Agent requests instead receive a JSON-RPC result with their original srq-* ID on the originating socket. The adapter's success result confirms socket delivery, not a separate backend acknowledgement. Cancellation, settled-ID fencing and reconnect restoration follow server-requests."},{"markdown":"Main-process WebSocket chat registers opaque renderer IDs through [[src/main/hermes.ts#registerPendingApproval]], bound to the originating renderer and run by [[src/main/ipc/register.ts#registerIpcHandlers]]. These IDs map to upstream legacy or current wire IDs; they never substitute for them. Completion, cancellation, renderer destruction, or connection loss clears pending interactions. Run cleanup retains the originating connection key; cancelled IPC calls settle, and runs that finish before their handle arrives are not registered as active. A transport failure after any interactive request cannot replay the prompt; see [[main-server-requests#Interactive turns never replay]]. Callers without an approval UI fail closed. `Always allow` requires a second confirmation because the gateway persists that permission.","startLine":187,"endLine":187,"text":"Main-process WebSocket chat registers opaque renderer IDs through src/main/hermes.ts#registerPendingApproval, bound to the originating renderer and run by src/main/ipc/register.ts#registerIpcHandlers. These IDs map to upstream legacy or current wire IDs; they never substitute for them. Completion, cancellation, renderer destruction, or connection loss clears pending interactions. Run cleanup retains the originating connection key; cancelled IPC calls settle, and runs that finish before their handle arrives are not registered as active. A transport failure after any interactive request cannot replay the prompt; see main-server-requests#Interactive turns never replay. Callers without an approval UI fail closed. Always allow requires a second confirmation because the gateway persists that permission."},{"markdown":"Desktop's Runs API adapter has no supported per-request approval contract. It therefore stops Runs turns that request approval, using the original connection's credentials, and directs users to Dashboard chat. Ordinary Runs streaming remains available; the adapter never grants a queue-head approval without request correlation.","startLine":189,"endLine":189,"text":"Desktop's Runs API adapter has no supported per-request approval contract. It therefore stops Runs turns that request approval, using the original connection's credentials, and directs users to Dashboard chat. Ordinary Runs streaming remains available; the adapter never grants a queue-head approval without request correlation."},{"markdown":"Dashboard regression tests simulate expired requests and lost acknowledgments with a queued second command, ensuring retries cannot approve that next command and unresolved responses stop the turn.","startLine":193,"endLine":193,"text":"Dashboard regression tests simulate expired requests and lost acknowledgments with a queued second command, ensuring retries cannot approve that next command and unresolved responses stop the turn."},{"markdown":"WebSocket transport tests verify opaque renderer IDs map to gateway IDs, and missing IDs, disconnects, or lost prompt acknowledgments stop the turn without replaying it.","startLine":197,"endLine":197,"text":"WebSocket transport tests verify opaque renderer IDs map to gateway IDs, and missing IDs, disconnects, or lost prompt acknowledgments stop the turn without replaying it."},{"markdown":"Renderer tests keep answered and expired legacy approvals out of the FIFO and mark successful responses resolved immediately.","startLine":201,"endLine":201,"text":"Renderer tests keep answered and expired legacy approvals out of the FIFO and mark successful responses resolved immediately."},{"markdown":"Current replay tests additionally fence stale same-socket snapshots and restore unanswered requests only after a real reconnect adopts their owner.","startLine":203,"endLine":203,"text":"Current replay tests additionally fence stale same-socket snapshots and restore unanswered requests only after a real reconnect adopts their owner."},{"markdown":"Runs transport tests verify approval events stop the original run with its captured credentials, never POST an approval, and never replay through chat completions.","startLine":207,"endLine":207,"text":"Runs transport tests verify approval events stop the original run with its captured credentials, never POST an approval, and never replay through chat completions."},{"markdown":"`/btw` (with aliases `/bg` and `/background`) is a side question that runs on a **concurrent background agent**, so it must never block or queue behind the main turn — that is the point of \"ask without affecting context\".","startLine":211,"endLine":211,"text":"/btw (with aliases /bg and /background) is a side question that runs on a concurrent background agent, so it must never block or queue behind the main turn — that is the point of \"ask without affecting context\"."},{"markdown":"It maps to the gateway's `prompt.background` RPC, which spawns a separate agent and reports back later via a `background.complete` event (a normal `prompt.submit` mid-turn is rejected with \"session busy\"). [[src/renderer/src/screens/Chat/hooks/useChatActions.ts#parseBackgroundCommand|parseBackgroundCommand]] detects these commands; `handleSubmitOrQueue` in [[src/renderer/src/screens/Chat/Chat.tsx]] fires them immediately — bypassing the busy queue — via the shared background flow (also used by the 💭 quick-ask button). The transport's `runBackground` ([[src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport]]) calls the RPC, and its gateway-event handler renders the `background.complete` answer as a standalone `[bg …]` message. The legacy (non-dashboard) transport has no background RPC and falls back to the blocking quick-ask.","startLine":213,"endLine":213,"text":"It maps to the gateway's prompt.background RPC, which spawns a separate agent and reports back later via a background.complete event (a normal prompt.submit mid-turn is rejected with \"session busy\"). parseBackgroundCommand detects these commands; handleSubmitOrQueue in src/renderer/src/screens/Chat/Chat.tsx fires them immediately — bypassing the busy queue — via the shared background flow (also used by the 💭 quick-ask button). The transport's runBackground (src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport) calls the RPC, and its gateway-event handler renders the background.complete answer as a standalone [bg …] message. The legacy (non-dashboard) transport has no background RPC and falls back to the blocking quick-ask."},{"markdown":"The central slash command architecture in [[src/renderer/src/screens/Chat/slash/handleSlashCommand.ts#handleSlashCommand]] classifies every slash command into a discriminated union (`target: \"desktop\" | \"agent\" | \"model\"`). Unrecognized commands return an error instead of reaching the model as prose.","startLine":217,"endLine":217,"text":"The central slash command architecture in src/renderer/src/screens/Chat/slash/handleSlashCommand.ts#handleSlashCommand classifies every slash command into a discriminated union (target: \"desktop\" | \"agent\" | \"model\"). Unrecognized commands return an error instead of reaching the model as prose."},{"markdown":"The router's attachment guard rejects a command run with staged attachments unless it declares `supportsAttachments`, but `target: \"desktop\"` commands are exempt — they are local UI actions / info displays that never consume attachments (the files stay in the composer for the next message), matching the pre-router behavior where local commands ran unconditionally. Only `agent`/`model` commands, which route content upstream, are gated.","startLine":219,"endLine":219,"text":"The router's attachment guard rejects a command run with staged attachments unless it declares supportsAttachments, but target: \"desktop\" commands are exempt — they are local UI actions / info displays that never consume attachments (the files stay in the composer for the next message), matching the pre-router behavior where local commands ran unconditionally. Only agent/model commands, which route content upstream, are gated."},{"markdown":"The command palette and executor share a catalog built by [[src/renderer/src/screens/Chat/slash/commandCatalog.ts#createSlashCatalog]]. Hermes Agent metadata comes from `commands.catalog`; Desktop commands are merged after collision validation, and upstream names/aliases are normalized from `/name` to the router's canonical `name`.","startLine":221,"endLine":221,"text":"The command palette and executor share a catalog built by src/renderer/src/screens/Chat/slash/commandCatalog.ts#createSlashCatalog. Hermes Agent metadata comes from commands.catalog; Desktop commands are merged after collision validation, and upstream names/aliases are normalized from /name to the router's canonical name."},{"markdown":"The same successful catalog read is recorded through the bounded compatibility bridge described by [[agent-capabilities#Bounded command inventory]]. Only normalized names reach the main-process cache; a failed read clears prior command evidence so capability gates become unknown rather than stale.","startLine":223,"endLine":223,"text":"The same successful catalog read is recorded through the bounded compatibility bridge described by agent-capabilities#Bounded command inventory. Only normalized names reach the main-process cache; a failed read clears prior command evidence so capability gates become unknown rather than stale."},{"markdown":"[[src/renderer/src/screens/Chat/slash/commandCatalog.ts#reconcileSlashCatalog]] merges the backend catalog with the in-repo desktop commands into a conflict-free catalog before it reaches `createSlashCatalog`. Desktop commands are authored in-repo and win deterministically; the backend catalog is untrusted runtime data, so a collision there must never crash the app. Any backend command whose name equals a desktop command **name or alias** is dropped (missing the alias check let a backend `/commands` command squat `help`'s `commands` alias and crash startup — #813), and a `canon` alias that targets a desktop command becomes an agent-visible alias entry instead.","startLine":225,"endLine":225,"text":"src/renderer/src/screens/Chat/slash/commandCatalog.ts#reconcileSlashCatalog merges the backend catalog with the in-repo desktop commands into a conflict-free catalog before it reaches createSlashCatalog. Desktop commands are authored in-repo and win deterministically; the backend catalog is untrusted runtime data, so a collision there must never crash the app. Any backend command whose name equals a desktop command name or alias is dropped (missing the alias check let a backend /commands command squat help's commands alias and crash startup — #813), and a canon alias that targets a desktop command becomes an agent-visible alias entry instead."},{"markdown":"[[src/renderer/src/screens/Chat/slash/commandCatalog.ts#agentCommandsFromCatalog]] reconciles the gateway's two-part catalog — the flat `pairs` command list and the `canon` alias map — into a self-consistent shape first. Because `createSlashCatalog` deliberately throws on a name registered twice (to catch genuine desktop-authoring conflicts), the reconciler drops any `canon` alias whose name is already a first-class `pairs` command: the backend can legitimately expose the same name as both (e.g. `/compact` is a standalone TUI command _and_ an alias of `/compress`), and without this guard the merge would throw and crash the app on agent connect.","startLine":227,"endLine":227,"text":"src/renderer/src/screens/Chat/slash/commandCatalog.ts#agentCommandsFromCatalog reconciles the gateway's two-part catalog — the flat pairs command list and the canon alias map — into a self-consistent shape first. Because createSlashCatalog deliberately throws on a name registered twice (to catch genuine desktop-authoring conflicts), the reconciler drops any canon alias whose name is already a first-class pairs command: the backend can legitimately expose the same name as both (e.g. /compact is a standalone TUI command and an alias of /compress), and without this guard the merge would throw and crash the app on agent connect."},{"markdown":"Desktop commands in [[src/renderer/src/screens/Chat/slash/desktopCommands.ts#DESKTOP_SLASH_COMMANDS]] handle local Electron/renderer UI operations such as opening settings, triggering the active chat's model picker, and switching navigation views without sending prompts.","startLine":231,"endLine":231,"text":"Desktop commands in src/renderer/src/screens/Chat/slash/desktopCommands.ts#DESKTOP_SLASH_COMMANDS handle local Electron/renderer UI operations such as opening settings, triggering the active chat's model picker, and switching navigation views without sending prompts."},{"markdown":"Pure UI desktop actions are flagged `uiAction: true` (settings, model picker, navigation, `/new`, `/clear`, `/fast`). [[src/renderer/src/screens/Chat/hooks/useChatActions.ts#useChatActions]] reads that flag to suppress the echoed `/command` user bubble for them — their effect is the UI change itself, so a bubble would be a dangling artifact. Output-producing desktop commands (`/help`, `/memory`, `/usage`, …) are not flagged and still echo, so their output reads as a reply.","startLine":233,"endLine":233,"text":"Pure UI desktop actions are flagged uiAction: true (settings, model picker, navigation, /new, /clear, /fast). src/renderer/src/screens/Chat/hooks/useChatActions.ts#useChatActions reads that flag to suppress the echoed /command user bubble for them — their effect is the UI change itself, so a bubble would be a dangling artifact. Output-producing desktop commands (/help, /memory, /usage, …) are not flagged and still echo, so their output reads as a reply."},{"markdown":"`/settings <section>` forwards the section name through `openSettings` to [[src/renderer/src/screens/Layout/Layout.tsx]], which opens the global settings modal on the matching nav item (see [[sidebar-navigation#Settings modal]]). [[src/renderer/src/components/settings/SettingsModal.tsx#resolveSection]] maps the argument to a nav id (`appearance`, `privacy`, `connection`, …, plus the legacy alias `hermesagent` → About); an unknown or omitted name lands on the first item.","startLine":235,"endLine":235,"text":"/settings <section> forwards the section name through openSettings to src/renderer/src/screens/Layout/Layout.tsx, which opens the global settings modal on the matching nav item (see sidebar-navigation#Settings modal). src/renderer/src/components/settings/SettingsModal.tsx#resolveSection maps the argument to a nav id (appearance, privacy, connection, …, plus the legacy alias hermesagent → About); an unknown or omitted name lands on the first item."},{"markdown":"Asynchronous Agent commands render a temporary slash-loader bubble without transcript actions such as Copy; the bubble is replaced by the command output or error when execution finishes.","startLine":237,"endLine":237,"text":"Asynchronous Agent commands render a temporary slash-loader bubble without transcript actions such as Copy; the bubble is replaced by the command output or error when execution finishes."},{"markdown":"Agent commands forward upstream via [[src/renderer/src/screens/Chat/slash/executeAgentCommand.ts#executeAgentCommand]] using gateway JSON-RPC.","startLine":241,"endLine":241,"text":"Agent commands forward upstream via src/renderer/src/screens/Chat/slash/executeAgentCommand.ts#executeAgentCommand using gateway JSON-RPC."},{"markdown":"Model commands and Agent `send`/skill directives pass through [[src/renderer/src/screens/Chat/slash/prepareModelSubmission.ts#prepareModelSubmission]] before entering the standard chat transport. This is the only slash route allowed to submit model content.","startLine":245,"endLine":245,"text":"Model commands and Agent send/skill directives pass through src/renderer/src/screens/Chat/slash/prepareModelSubmission.ts#prepareModelSubmission before entering the standard chat transport. This is the only slash route allowed to submit model content."},{"markdown":"Visual presentation in the autocomplete popup is handled by [[src/renderer/src/screens/Chat/slash/SlashCommandIcon.tsx#SlashCommandIcon]], mapping command names to Lucide icons with fallback defaults and a custom SVG registry. Every slash command including desktop settings and navigation shortcuts is assigned an icon.","startLine":249,"endLine":249,"text":"Visual presentation in the autocomplete popup is handled by src/renderer/src/screens/Chat/slash/SlashCommandIcon.tsx#SlashCommandIcon, mapping command names to Lucide icons with fallback defaults and a custom SVG registry. Every slash command including desktop settings and navigation shortcuts is assigned an icon."},{"markdown":"Custom icons render via `dangerouslySetInnerHTML`, so string SVGs passed to [[src/renderer/src/screens/Chat/slash/SlashCommandIcon.tsx#registerCustomSlashSvg]] are stripped of `<script>`/`<foreignObject>`, inline `on*` handlers, and `javascript:` URIs before storage — a defensive guard (real icons never need them), not a full sanitizer. Only register trusted markup; route remote/plugin-sourced SVG through a proper sanitizer first.","startLine":251,"endLine":251,"text":"Custom icons render via dangerouslySetInnerHTML, so string SVGs passed to src/renderer/src/screens/Chat/slash/SlashCommandIcon.tsx#registerCustomSlashSvg are stripped of <script>/<foreignObject>, inline on* handlers, and javascript: URIs before storage — a defensive guard (real icons never need them), not a full sanitizer. Only register trusted markup; route remote/plugin-sourced SVG through a proper sanitizer first."},{"markdown":"Typing `/` opens a centered command palette in [[src/renderer/src/screens/Chat/ChatInput.tsx#ChatInput]] while the composer retains keyboard focus. Results filter by name or description, stay grouped by category, and support arrows, Enter or Tab, and Escape.","startLine":253,"endLine":253,"text":"Typing / opens a centered command palette in src/renderer/src/screens/Chat/ChatInput.tsx#ChatInput while the composer retains keyboard focus. Results filter by name or description, stay grouped by category, and support arrows, Enter or Tab, and Escape."},{"markdown":"Escape is captured at the document level while the palette is open, so it closes even if focus has moved from the composer into a command row. Dismissal preserves the slash draft and returns focus to the composer.","startLine":255,"endLine":255,"text":"Escape is captured at the document level while the palette is open, so it closes even if focus has moved from the composer into a command row. Dismissal preserves the slash draft and returns focus to the composer."},{"markdown":"The palette pre-normalizes searchable command metadata and virtualizes its grouped rows through [[src/renderer/src/screens/Chat/slash/virtualSlashCommands.ts#createSlashCommandVirtualLayout]]. Only visible rows plus a small overscan are mounted, while keyboard selection uses calculated offsets.","startLine":257,"endLine":257,"text":"The palette pre-normalizes searchable command metadata and virtualizes its grouped rows through src/renderer/src/screens/Chat/slash/virtualSlashCommands.ts#createSlashCommandVirtualLayout. Only visible rows plus a small overscan are mounted, while keyboard selection uses calculated offsets."},{"markdown":"Dashboard clarify requests preserve structured choices. Answers and skips must return through the originating dashboard client, while local cards retain IPC delivery.","startLine":261,"endLine":261,"text":"Dashboard clarify requests preserve structured choices. Answers and skips must return through the originating dashboard client, while local cards retain IPC delivery."},{"markdown":"[[src/renderer/src/screens/Chat/dashboardEventAdapter.ts#appendClarifyRequest]] creates a dashboard-tagged card. [[src/renderer/src/screens/Chat/Chat.tsx#Chat]] supplies the transport responder to [[src/renderer/src/screens/Chat/ClarifyCard.tsx]]. [[src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport]] shares delivery with the composer and invalidates pending questions on connection/session changes, completion, abort or teardown. Legacy answers require the Agent's `status: ok`; current requests send a matching-ID `{answers}` response and return adapter success once it is sent. The card retains retry feedback on delivery failure. Tests: [[dashboard-clarify]].","startLine":263,"endLine":263,"text":"src/renderer/src/screens/Chat/dashboardEventAdapter.ts#appendClarifyRequest creates a dashboard-tagged card. src/renderer/src/screens/Chat/Chat.tsx#Chat supplies the transport responder to src/renderer/src/screens/Chat/ClarifyCard.tsx. src/renderer/src/screens/Chat/hooks/useDashboardChatTransport.ts#useDashboardChatTransport shares delivery with the composer and invalidates pending questions on connection/session changes, completion, abort or teardown. Legacy answers require the Agent's status: ok; current requests send a matching-ID {answers} response and return adapter success once it is sent. The card retains retry feedback on delivery failure. Tests: dashboard-clarify."},{"markdown":"Legacy `clarify.expire` and current `request.cancel` disable only the matching pending card. A disconnect first disables controls and clears the old runtime identity; unanswered current requests may then restore from the new connection's `open_requests` after runtime adoption. Settled requests cannot be reopened by stale same-socket snapshots. Legacy terminal-card replays stay closed.","startLine":265,"endLine":265,"text":"Legacy clarify.expire and current request.cancel disable only the matching pending card. A disconnect first disables controls and clears the old runtime identity; unanswered current requests may then restore from the new connection's open_requests after runtime adoption. Settled requests cannot be reopened by stale same-socket snapshots. Legacy terminal-card replays stay closed."},{"markdown":"Current clarification presents one form for up to five questions, retaining server-locked answers and encoding selected multiple choices as the Agent's JSON-array strings. Send and Ctrl/Command+Enter submit the complete answer map; Skip leaves unanswered entries null. Question and answer bounds, malformed-input handling and replay rules are documented in [[server-requests#Batch clarification]].","startLine":267,"endLine":267,"text":"Current clarification presents one form for up to five questions, retaining server-locked answers and encoding selected multiple choices as the Agent's JSON-array strings. Send and Ctrl/Command+Enter submit the complete answer map; Skip leaves unanswered entries null. Question and answer bounds, malformed-input handling and replay rules are documented in server-requests#Batch clarification."}],"blocks":[{"type":"heading","start":0,"end":25,"startLine":1,"endLine":1,"children":[]},{"type":"paragraph","start":27,"end":269,"startLine":3,"endLine":3,"children":[]},{"type":"paragraph","start":271,"end":667,"startLine":5,"endLine":5,"children":[]},{"type":"paragraph","start":669,"end":1554,"startLine":7,"endLine":7,"children":[]},{"type":"heading","start":1556,"end":1575,"startLine":9,"endLine":9,"children":[]},{"type":"paragraph","start":1577,"end":1838,"startLine":11,"endLine":11,"children":[]},{"type":"paragraph","start":1840,"end":2171,"startLine":13,"endLine":13,"children":[]},{"type":"paragraph","start":2173,"end":2457,"startLine":15,"endLine":15,"children":[]},{"type":"heading","start":2459,"end":2487,"startLine":17,"endLine":17,"children":[]},{"type":"paragraph","start":2489,"end":2696,"startLine":19,"endLine":19,"children":[]},{"type":"paragraph","start":2698,"end":2992,"startLine":21,"endLine":21,"children":[]},{"type":"heading","start":2994,"end":3017,"startLine":23,"endLine":23,"children":[]},{"type":"paragraph","start":3019,"end":3242,"startLine":25,"endLine":25,"children":[]},{"type":"paragraph","start":3244,"end":3548,"startLine":27,"endLine":27,"children":[]},{"type":"paragraph","start":3550,"end":3985,"startLine":29,"endLine":29,"children":[]},{"type":"heading","start":3987,"end":4020,"startLine":31,"endLine":31,"children":[]},{"type":"paragraph","start":4022,"end":4221,"startLine":33,"endLine":33,"children":[]},{"type":"paragraph","start":4223,"end":5176,"startLine":35,"endLine":35,"children